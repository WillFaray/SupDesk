root = true

# Padrão do repositório: LF (ver .gitattributes) + newline final.
# O Prettier está com endOfLine = "lf" para manter o mesmo padrão.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Backend (src/**): 4 espaços — ver .prettierrc.json (tabWidth padrão)
# Frontend (web/**): 2 espaços — ver override no .prettierrc.json
[web/**]
indent_size = 2

[*.{json,yml,yaml,html,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
