{
    "name": "supdesk",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node ./dist/server.js",
        "dev:web": "npm run dev --workspace web",
        "build:web": "npm run build --workspace web",
        "typecheck": "tsc --noEmit && npm run typecheck --workspace web",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write . --ignore-unknown",
        "format:check": "prettier --check . --ignore-unknown",
        "test": "npm run test:api && npm run test:web",
        "test:api": "vitest run",
        "test:api:watch": "vitest",
        "test:web": "npm run test --workspace web",
        "test:coverage": "npm run test:api -- --coverage && npm run test:coverage --workspace web"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "workspaces": [
        "web"
    ],
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^7.1.5",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.22.0",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.6",
        "@types/express-rate-limit": "^6.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.4",
        "@types/supertest": "^7.2.1",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@vitest/coverage-v8": "^3.2.7",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.8",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^3.2.7"
    }
}
