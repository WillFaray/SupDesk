# URL base da API (o proxy de dev usa /api -> API_URL; em produção, descomente e aponte a API real)
VITE_API_URL=/api

# Modo demonstração: quando "true", a UI usa dados sintéticos ROTULADOS como DEMO
# para permitir ver o produto sem o backend rodando. Nunca use em produção.
VITE_DEMO=true

# Timeout das requisições à API, em milissegundos (padrão: 15000).
# VITE_API_TIMEOUT=15000